# Runpod PyTorch base — CUDA 12.8.1 / torch 2.8.0 / Ubuntu 24.04
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ARG DEBIAN_FRONTEND=noninteractive

# 1) OS deps: AWS CLI v2 + git/curl/unzip + tini
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ca-certificates git tini && \
    rm -rf /var/lib/apt/lists/*

# AWS CLI v2 (architecture auto-detect)
RUN ARCH="$(uname -m)" && \
    case "$ARCH" in \
        x86_64) URL="https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" ;; \
        aarch64) URL="https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" ;; \
        *) echo "unsupported arch: $ARCH" && exit 1 ;; \
    esac && \
    curl -fsSL "$URL" -o /tmp/awscli.zip && \
    unzip -q /tmp/awscli.zip -d /tmp/ && \
    /tmp/aws/install && \
    rm -rf /tmp/awscli.zip /tmp/aws

# 2) uv 설치
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# 3) Python 의존성 (lock 강제 → 재현성)
#    /workspace 는 런타임 git clone 대상이라 lock 파일은 별도 dir 에 둠
WORKDIR /opt/project
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# 4) Bootstrap 스크립트만 baked-in. 나머지 코드는 런타임에 git clone
COPY scripts/runpod_bootstrap.sh /usr/local/bin/runpod-bootstrap.sh
RUN chmod +x /usr/local/bin/runpod-bootstrap.sh

# 5) 작업 디렉터리 = clone 위치
WORKDIR /workspace

# 6) 기본 환경변수 (실행 시 -e 로 override)
ENV REPO_URL=https://github.com/ml-jeongmin-do/runpod-launcher.git \
    REPO_REF=main \
    GITHUB_TOKEN="" \
    MODEL=cbf-reprod \
    DATE="" \
    DATA_ROOT=/data \
    AWS_DEFAULT_REGION=ap-northeast-2 \
    WANDB_API_KEY="" \
    WANDB_PROJECT=cbf-exp \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/runpod-bootstrap.sh"]
